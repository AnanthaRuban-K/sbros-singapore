# SBros Tech Singapore website (Vite + React SPA) on Apache / cPanel.
# Copied to dist/.htaccess by `npm run build`.

# ---------------------------------------------------------
# SPA routing: send deep links (/Pricing, /module-pricing/hrm, ...)
# to index.html; real files and folders are served as-is.
# ---------------------------------------------------------
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# ---------------------------------------------------------
# Caching
# ---------------------------------------------------------
<IfModule mod_headers.c>
  # index.html: always revalidate so a new deploy is picked up at once
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Fixed-name images / video copied from public/assets: 1 week
  # (they can be replaced under the same name)
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Vite build output has a content hash in the name
  # (e.g. index-ZUIyexgP.js): cache for 1 year, never revalidate
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
