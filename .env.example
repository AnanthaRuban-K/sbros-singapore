# Copy to .env.local for local development.
# VITE_* values are baked into the bundle at build time:
# set them in the hosting provider's BUILD settings and redeploy after a change.

# One Solution ERP base URL (no trailing slash).
# Plan buttons post leads to ${VITE_ERP_API_URL}/api/v1/public/leads
VITE_ERP_API_URL=https://erp.sbrostech.com.sg
